{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "app",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "prepare common defines",
            "toolArgs": [
                "--dart-define-from-file=.dart_tool/vscode/common_defines.json"
            ]
        },
        {
            "name": "Quiz: local server",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "preLaunchTask": "prepare local API",
            "toolArgs": [
                "--dart-define-from-file=.dart_tool/vscode/common_defines.json",
                "--dart-define-from-file=.dart_tool/vscode/local_api_defines.json"
            ]
        }
    ]
}
